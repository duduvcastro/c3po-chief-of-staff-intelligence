{$PLUGGY_WEBHOOK_HOST} {
    encode zstd gzip
    reverse_proxy pluggy-webhook:8080
}

{$C3PO_HOST} {
    encode zstd gzip
    @forwarded_http header X-Forwarded-Proto http
    redir @forwarded_http https://{host}{uri} 308

    @cloudflare_http header_regexp cf_scheme CF-Visitor scheme.*http([^s]|$)
    redir @cloudflare_http https://{host}{uri} 308

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
    }
    reverse_proxy c3po-web:80
}
