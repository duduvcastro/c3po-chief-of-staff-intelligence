C3PO_ENVIRONMENT=production
C3PO_DB_PASSWORD=replace-with-a-long-random-password
C3PO_HOST=c3po.18-230-60-255.sslip.io
C3PO_PUBLIC_API_URL=
C3PO_AUTH_SESSION_HOURS=24
C3PO_AUTH_OWNER_SESSION_HOURS=24
C3PO_AUTH_MEMBER_IDLE_MINUTES=30

# Add when contracted. Never commit real values.
BRAPI_TOKEN=
C3PO_BRAPI_PLAN=pro
EODHD_API_TOKEN=
C3PO_EODHD_PLAN=all-in-one
FINNHUB_API_TOKEN=
FMP_API_TOKEN=
C3PO_FMP_PLAN=ultimate
# Massive (formerly Polygon.io). REST and Flat Files use separate credentials.
# Keep all real values only in the server environment file.
MASSIVE_API_TOKEN=
C3PO_MASSIVE_PLAN=stocks-advanced
C3PO_MASSIVE_FLAT_FILES_ACCESS_KEY=
C3PO_MASSIVE_FLAT_FILES_SECRET_KEY=
C3PO_DAY_D_DATASET_ROOT=/app/day-d-data
C3PO_DAY_D_DATASET_MIN_FREE_DISK_GB=20
C3PO_DAY_D_POINT_IN_TIME_REFERENCE_AUTHORIZED=false
# Keep the named volume locally. Production uses the dedicated Lightsail disk:
# C3PO_DAY_D_DATA_MOUNT_SOURCE=/mnt/day-d-data
C3PO_DAY_D_DATA_MOUNT_SOURCE=c3po_day_d_data
C3PO_MARKET_DATA_TIMEOUT_SECONDS=15
C3PO_PUBLIC_URL=https://c3po.eduardocastro.com.br
C3PO_MARKET_DATA_MAX_RETRIES=2

# Dedicated mailbox for login codes and security alerts. If omitted, the
# legacy Exchange credentials remain as a temporary fallback.
C3PO_NOTIFICATION_EXCHANGE_SERVER=
C3PO_NOTIFICATION_EXCHANGE_USER=c3po@eduardocastro.com.br
C3PO_NOTIFICATION_EXCHANGE_APP_PASSWORD=

# Falcon CAPCOM AI usage telemetry. These are organization admin keys,
# separate from the runtime API keys used to call models.
C3PO_OPENAI_ADMIN_API_KEY=
C3PO_OPENAI_USAGE_PROJECT_IDS=
C3PO_ANTHROPIC_API_KEY=
C3PO_ANTHROPIC_ADMIN_API_KEY=
C3PO_ANTHROPIC_USAGE_WORKSPACE_IDS=
C3PO_R2D2_FAST_RISK_WATCHER_ENABLED=false
C3PO_R2D2_ENTRY_SCORE_ADAPTER_ENABLED=false
C3PO_R2D2_CASH_YIELD_ACCOUNTING_ENABLED=false
C3PO_R2D2_FAST_RISK_WATCHER_INTERVAL_SECONDS=1
C3PO_R2D2_FAST_RISK_TICK_MAX_AGE_SECONDS=10
C3PO_R2D2_FAST_RISK_ATR_MAX_AGE_SECONDS=30
