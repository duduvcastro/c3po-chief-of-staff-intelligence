{
  "schema_version": "1.0.0",
  "spec_version": "DAY-D-SIGNAL-UNIVERSE-v1",
  "status": "frozen_on_merge_after_six_hands_review",
  "effective_event": "merge_after_dudu_codex_fable_review",
  "production_behavior_change_authorized": false,
  "capital_use_authorized": false,
  "harness_implementation_in_scope": false,
  "versions": {
    "feature_version": "DAY-D-FEATURES-v1",
    "universe_version": "DAY-D-UNIVERSE-v1",
    "s3_version": "S3-v1",
    "s5_version": "S5-v1",
    "risk_policy_version": "DAY-D-RISK-v1"
  },
  "temporal_contract": {
    "timezone": "America/New_York",
    "calendar_source": "exchange_calendar",
    "regular_session_only": true,
    "bar_interval_seconds": 60,
    "bar_interval_semantics": "left_closed_right_open",
    "bar_available_only_at_or_after_interval_end": true,
    "same_bar_signal_and_fill_forbidden": true,
    "feature_event_at_must_be_lte_decision_at": true,
    "feature_available_at_must_be_lte_decision_at": true,
    "provider_revision_received_after_decision_is_ignored_for_that_decision": true
  },
  "universe": {
    "selection_count": 60,
    "benchmark_symbols": [
      "QQQ"
    ],
    "benchmark_is_tradeable_by_generation_one": false,
    "selection_information_cutoff": "D-1_official_close",
    "selection_is_immutable_intraday": true,
    "eligible_listing_mics": [
      "XNAS",
      "XNYS"
    ],
    "eligible_security_types": [
      "US_DOMESTIC_OPERATING_COMPANY_COMMON_STOCK",
      "US_DOMESTIC_EQUITY_REIT_COMMON_STOCK"
    ],
    "excluded_security_types": [
      "ADR",
      "ADS",
      "FOREIGN_ORDINARY",
      "ETF",
      "ETN",
      "FUND",
      "PREFERRED",
      "WARRANT",
      "UNIT",
      "RIGHT",
      "SPAC_SHELL",
      "CLOSED_END_FUND",
      "OTC_SECURITY"
    ],
    "minimum_d1_official_close_usd": 3.0,
    "ranking_lookback_completed_sessions": 20,
    "minimum_complete_ranking_sessions": 20,
    "session_dollar_volume_formula": "point_in_time_split_adjusted_official_close * point_in_time_split_adjusted_regular_session_volume",
    "ranking_statistic": "median_session_dollar_volume",
    "ranking_direction": "descending",
    "issuer_deduplication": {
      "enabled": true,
      "rule": "retain_the_share_class_with_highest_median_session_dollar_volume",
      "tie_break": "normalized_ticker_ascending"
    },
    "ranking_tie_breaks": [
      "normalized_ticker_ascending"
    ],
    "historical_membership": {
      "survivorship_free_required": true,
      "delisted_symbols_included_when_active_as_of_d1": true,
      "future_corporate_actions_forbidden": true,
      "adjustment_factors_must_be_known_by_d1": true,
      "symbol_mapping_must_be_known_by_d1": true
    },
    "preopen_substitution": {
      "cutoff_local_time": "09:25:00",
      "allowed_only_for_permanent_administrative_unavailability_known_by_cutoff": true,
      "allowed_reason_codes": [
        "DELISTING_EFFECTIVE_BEFORE_REGULAR_OPEN",
        "MERGER_OR_SECURITY_CANCELLATION_EFFECTIVE_BEFORE_REGULAR_OPEN",
        "POINT_IN_TIME_SYMBOL_MAPPING_RETIRED_BEFORE_REGULAR_OPEN"
      ],
      "forbidden_reason_codes": [
        "MISSING_INTRADAY_BAR",
        "MISSING_LIVE_QUOTE",
        "PROVIDER_OUTAGE",
        "TRADING_HALT",
        "LOW_INTRADAY_VOLUME",
        "INTRADAY_PRICE_MOVE"
      ],
      "source_order": "continue_down_frozen_d1_ranking",
      "intraday_replacement_for_halt_or_missing_data_forbidden": true,
      "recompute_ranking_with_d_information_forbidden": true
    },
    "insufficient_membership_rule": "use_fewer_than_60_and_emit_universe_shortfall",
    "manifest_required_fields": [
      "session_date",
      "rank",
      "symbol",
      "issuer_id",
      "listing_mic",
      "security_type",
      "d1_close_usd",
      "median_dollar_volume_20d_usd",
      "history_session_count",
      "selection_reason",
      "substitution_reason",
      "data_as_of",
      "universe_version"
    ]
  },
  "shared_features": {
    "one_minute_bar": {
      "source": "regular_session_trades_only",
      "open": "first_eligible_trade_price",
      "high": "maximum_eligible_trade_price",
      "low": "minimum_eligible_trade_price",
      "close": "last_eligible_trade_price",
      "volume": "sum_eligible_trade_size",
      "empty_bar_rule": "bar_is_missing_and_cannot_trigger_a_signal"
    },
    "vwap": {
      "reset": "each_regular_session",
      "typical_price_formula": "(high + low + close) / 3",
      "formula": "cumulative_sum(typical_price * volume) / cumulative_sum(volume)",
      "inputs": "completed_one_minute_bars_only",
      "zero_cumulative_volume_rule": "unavailable"
    },
    "rvol": {
      "numerator": "current_session_cumulative_volume_through_latest_completed_minute",
      "denominator": "median_cumulative_volume_through_same_minute_over_prior_20_eligible_sessions",
      "historical_window_sessions": 20,
      "minimum_historical_observations_for_same_minute": 15,
      "current_session_excluded_from_baseline": true,
      "future_sessions_forbidden": true,
      "insufficient_history_rule": "unavailable"
    },
    "atr": {
      "period_completed_one_minute_bars": 14,
      "true_range_formula": "max(high-low, abs(high-previous_close), abs(low-previous_close))",
      "first_current_session_previous_close": "D-1_official_close",
      "seed": "simple_mean_of_first_14_completed_current_session_true_ranges",
      "update": "Wilder((previous_atr*13 + current_true_range)/14)",
      "available_after_completed_bar_count": 14,
      "same_incomplete_bar_forbidden": true
    },
    "minimum_tick_usd": {
      "default": 0.01,
      "source_override": "point_in_time_listing_rule_when_different"
    }
  },
  "shared_risk_and_sizing": {
    "risk_budget_fraction_of_current_virtual_nav_at_entry": 0.0015,
    "risk_budget_usd_frozen_for_trade_lifetime": true,
    "maximum_simultaneous_positions": 5,
    "maximum_aggregate_initial_stop_risk_fraction": 0.0075,
    "maximum_position_notional_fraction_of_nav": 0.20,
    "portfolio_leverage_allowed": false,
    "maximum_participation_fraction_of_prior_five_completed_minutes_volume": 0.01,
    "minimum_stop_distance_formula": "max(0.50 * entry_atr, point_cost_model_full_spread_per_share, 2 * minimum_tick)",
    "maximum_stop_distance_atr_multiple": 2.0,
    "stop_distance_measurement": "entry_fill_price - structural_stop_price",
    "stop_floor_application": "move_structural_stop_down_only_enough_to_reach_minimum_stop_distance",
    "stop_too_wide_rule": "reject_when_post_floor_stop_distance_exceeds_2.0_entry_atr",
    "risk_per_share_formula": "entry_gross_cost_per_share - expected_point_scenario_stop_net_proceeds_per_share",
    "quantity_formula": "floor(risk_budget_usd / risk_per_share_usd)",
    "fractional_shares_allowed": false,
    "minimum_quantity_shares": 1,
    "oversized_notional_rule": "reject_not_resize",
    "participation_breach_rule": "reject_not_resize",
    "duplicate_symbol_across_setups_rule": "first_accepted_signal_keeps_symbol; later_signal_is_blocked_and_logged",
    "insufficient_cash_rule": "reject_and_log"
  },
  "setups": {
    "S3-v1": {
      "name": "ORB plus VWAP continuation",
      "family": "continuation",
      "maximum_signal_attempts_per_symbol_per_session": 1,
      "opening_range": {
        "start_local_time_inclusive": "09:30:00",
        "end_local_time_exclusive": "09:45:00",
        "required_completed_bars": 15,
        "high": "maximum_high_of_required_bars",
        "low": "minimum_low_of_required_bars",
        "range": "high-low",
        "zero_range_rule": "no_signal",
        "missing_bar_or_halt_rule": "no_signal_for_symbol_for_session"
      },
      "raw_breakout_event": "first_completed_bar_after_opening_range_with_close > opening_range_high",
      "decision_at": "raw_breakout_bar_end",
      "all_entry_gates": [
        "raw_breakout_bar.close > opening_range_high",
        "raw_breakout_bar.close > current_completed_bar_vwap",
        "raw_breakout_bar.rvol >= 1.5",
        "QQQ.latest_completed_bar.close > QQQ.current_completed_bar_vwap",
        "raw_breakout_bar.close <= opening_range_high + 0.5 * opening_range_range",
        "decision_at < 11:45:00"
      ],
      "failed_first_breakout_rule": "expire_setup_for_symbol_for_session_without_rearm",
      "suppressed_qqq_gate_signal_logged": true,
      "entry_activation": "first_execution_eligible_observation_strictly_after_decision_at_and_above_raw_breakout_bar_high",
      "entry_expiry": "earlier_of_three_completed_bars_after_decision_or_11:45:00",
      "entry_expiry_boundary": "fill_at_must_be_strictly_before_entry_expiry_at",
      "opening_gap_policy": {
        "premarket_entry_forbidden": true,
        "opening_range_rebuilt_from_current_regular_session": true,
        "previous_close_gap_is_not_a_separate_trigger": true,
        "signal_before_opening_range_complete_forbidden": true
      },
      "initial_structural_stop": "max(opening_range_low, entry_time_vwap)",
      "stop_uses_shared_floor_and_maximum": true,
      "profit_plan": {
        "r_levels_use_frozen_trade_risk_per_share": true,
        "partial_target_r": 1.5,
        "partial_quantity_fraction": 0.50,
        "partial_quantity_rounding": "floor_shares_with_all_remaining_shares_in_runner",
        "single_share_rule": "skip_partial_and_keep_single_share_as_runner",
        "runner_target_r": 2.0,
        "chandelier_activates_after_partial_fill": true,
        "chandelier_atr_multiple": 2.5,
        "chandelier_atr_source": "latest_completed_one_minute_atr",
        "chandelier_high_water_source": "highest_execution_eligible_trade_since_entry",
        "chandelier_stop_formula": "max(previous_chandelier_stop, high_water - 2.5 * latest_completed_atr)",
        "chandelier_is_monotonic": true,
        "runner_exit": "first_of_2R_target_chandelier_or_portfolio_risk_override"
      },
      "same_timestamp_exit_precedence": [
        "hard_or_initial_stop",
        "chandelier",
        "2R_target",
        "T30_or_other_portfolio_override"
      ]
    },
    "S5-v1": {
      "name": "bar-based VWAP mean reversion",
      "family": "mean_reversion",
      "uses_cvd": false,
      "uses_order_flow": false,
      "uses_qqq_gate": false,
      "maximum_signal_attempts_per_symbol_per_session": 1,
      "earliest_possible_evaluation": "after_14_completed_regular_session_bars",
      "excursion_event": "first_completed_bar_with_low <= current_completed_bar_vwap - 1.5 * current_completed_bar_atr",
      "excursion_low": "minimum_completed_bar_low_from_excursion_event_through_reclaim_bar",
      "reclaim_event": "first_later_completed_bar_with_close > midpoint_of_immediately_preceding_completed_bar_and_rvol >= 1.5",
      "preceding_bar_midpoint_formula": "(preceding_bar.high + preceding_bar.low) / 2",
      "decision_at": "reclaim_bar_end",
      "entry_activation": "first_execution_eligible_observation_strictly_after_decision_at_and_above_reclaim_bar_high",
      "entry_expiry": "earlier_of_three_completed_bars_after_decision_or_14:30:00",
      "entry_expiry_boundary": "fill_at_must_be_strictly_before_entry_expiry_at",
      "new_fill_at_or_after_14_30_forbidden": true,
      "initial_structural_stop": "excursion_low - minimum_tick",
      "stop_uses_shared_floor_and_maximum": true,
      "target": {
        "value": "completed_bar_vwap_observed_at_entry_fill_time",
        "frozen_for_trade_lifetime": true,
        "moving_vwap_after_entry_ignored": true,
        "target_must_be_strictly_above_entry_fill": true,
        "invalid_target_rule": "reject_signal"
      },
      "maximum_holding_seconds": 2700,
      "timeout_anchor": "entry_fill_at",
      "timeout_exit": "marketable_exit_at_first_execution_eligible_observation_at_or_after_timeout",
      "same_timestamp_exit_precedence": [
        "hard_or_initial_stop",
        "frozen_vwap_target",
        "45_minute_timeout",
        "T30_or_other_portfolio_override"
      ],
      "failed_or_expired_attempt_rule": "no_rearm_for_symbol_for_session"
    }
  },
  "anti_lookahead_invariants": [
    "every_input_has_event_at_and_available_at",
    "event_at_and_available_at_are_not_after_decision_at",
    "one_minute_bar_is_unavailable_before_its_end",
    "signal_bar_cannot_fill_itself",
    "universe_and_rank_are_computed_only_from_information_available_by_D1",
    "cross_sectional_values_use_only_the_frozen_D1_observable_universe",
    "historical_adjustments_never_use_a_future_corporate_action",
    "cost_cells_for_session_D_use_only_sessions_before_D",
    "provider_corrections_do_not_rewrite_prior_decisions",
    "randomized_components_use_a_persisted_deterministic_seed"
  ],
  "required_signal_audit_fields": [
    "setup_version",
    "feature_version",
    "universe_version",
    "session_date",
    "symbol",
    "signal_event_at",
    "signal_available_at",
    "decision_at",
    "feature_as_of",
    "all_gate_values",
    "gate_result",
    "suppression_or_rejection_reason",
    "entry_expiry_at",
    "risk_budget_usd",
    "structural_stop",
    "post_floor_stop",
    "entry_atr",
    "entry_vwap",
    "entry_rvol",
    "universe_rank"
  ],
  "separate_harness_contract_still_required": [
    "fresh_quote_and_execution_eligible_observation",
    "latency_and_jitter",
    "marketable_entry_fill",
    "two_print_stop_confirmation_and_notional_floor",
    "halt_and_reopening_fill",
    "cost_quintile_time_bucket_table",
    "corporate_action_and_delisting_ledger_accounting",
    "synthetic_truth_ci_gate"
  ]
}
