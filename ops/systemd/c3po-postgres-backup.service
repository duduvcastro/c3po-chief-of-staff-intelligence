[Unit]
Description=C3PO offsite PostgreSQL backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/day-d-data

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/chief-of-staff-digital
ExecStart=/usr/local/sbin/c3po-postgres-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
